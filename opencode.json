{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "supabase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "http://127.0.0.1:54723/api/mcp",
        "--allow-http",
        "--transport",
        "http-only"
      ],
      "enabled": true
    }
  }
}
